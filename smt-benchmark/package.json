{
  "name": "smt-bench",
  "version": "0.0.1",
  "description": "Benchmark for Sparse Merkle Tree Circom implementation of iden3",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha -r ts-node/register --max-old-space-size=4000",
    "smtbench:default": "npm run smtbench smt_depth=10 proof_system=groth16",
    "clean": "rm -rf test/circuits/circuit_artifacts/*.zkey test/circuits/circuit_artifacts/*.json test/circuits/circuit_artifacts/*.wtns test/circuits/compiled_outputs/*",
    "smtbench": "npm run test ./test/smtbench.spec.ts",
    "smtsingleprocessor:defaultbench": "npm run smtbench smt_depth=10 proof_system=groth16 circuit=smt-single-processor",
    "smtbatchprocessor:defaultbench": "npm run smtbench smt_depth=10 proof_system=groth16 circuit=smt-batch-processor",
    "smtbatchprocessor:largebench": "npm run smtbench smt_depth=254 proof_system=groth16 circuit=smt-batch-processor"
  },
  "keywords": [
    "pedersen",
    "hash",
    "ethereum",
    "circuit",
    "circom",
    "zksnark"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/circomlib.git"
  },
  "author": "0Kims",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "blake-hash": "^2.0.0",
    "chai": "^4.3.4",
    "circom_tester": "0.0.13",
    "circomlibjs": "^0.1.4",
    "i": "^0.3.7",
    "mocha": "^9.1.3"
  },
  "dependencies": {
    "@types/mocha": "^10.0.8",
    "circom_tester_fix": "^0.0.20-bugfix-1",
    "circomlib": "^2.0.5",
    "csv-writer": "^1.6.0",
    "snarkjs": "^0.7.4",
    "systeminformation": "^5.23.5",
    "ts-node": "^10.9.2",
    "zod": "^3.23.8"
  }
}
